[Unit]
Description=DVBStreamer5 OSCam-mini Newcamd/PCSC/Phoenix card server
After=network.target
Conflicts=oscam.service
ConditionPathExists=/etc/dvbstreamer5/oscam-mini/oscam.conf

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/DVBStreamer5/oscam-mini
ExecStart=/opt/DVBStreamer5/oscam-mini/oscam-mini -c /etc/dvbstreamer5/oscam-mini
SuccessExitStatus=15 SIGTERM
Restart=on-failure
RestartSec=2
Nice=5
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
