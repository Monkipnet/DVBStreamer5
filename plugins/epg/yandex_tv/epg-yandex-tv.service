[Unit]
Description=DVBStreamer5 Yandex TV EPG plugin (isolated XMLTV provider)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=dvbstreamer5-yandex-epg
ExecStart=/usr/bin/python3 /opt/DVBStreamer5/scripts/epg-yandex-tv/plugin.py --config /etc/epg-yandex-tv/config.json --output /var/lib/dvbstreamer5-yandex-epg/epg.xml
Restart=on-failure
RestartSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
